      "label": "Signatories",
      "method": "GET",
      "path": "/Signatories",
      "mockType": "signatories",
      "parameters": [
        { "name": "AccountNo", "label": "Account number", "placeholder": "10-digit account number",  "required": true, "digitsOnly": true, "minLength": 10, "maxLength": 10 }
      ]
    },
    {
