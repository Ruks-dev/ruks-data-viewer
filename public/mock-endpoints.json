        { "name": "AccountNo", "label": "Account number", "placeholder": "10-digit account number", "required": true, "digitsOnly": true, "minLength": 10, "maxLength": 10 },
        { "name": "Count", "label": "Number of transactions", "placeholder": "10",  "type": "number", "required": false }
      ]
    },
    {
      "id": "transaction-count",
      "label": "Transaction count",
      "method": "GET",
      "path": "/TransactionCount",
      "mockType": "transactionCount",
      "parameters": [
        { "name": "AccountNo", "label": "Account number", "placeholder": "10-digit account number",  "required": true, "digitsOnly": true, "minLength": 10, "maxLength": 10 }
      ]
    },
    {
